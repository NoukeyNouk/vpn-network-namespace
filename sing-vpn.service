[Unit]
Description=VPN application network namespace
After=network-online.target sing-box.service
Wants=network-online.target
Requires=sing-box.service
PartOf=sing-box.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash /usr/local/lib/mega-vpn/setup-netns.sh
ExecStop=/usr/bin/bash /usr/local/lib/mega-vpn/teardown-netns.sh
TimeoutStartSec=45
TimeoutStopSec=10
UMask=0022

[Install]
WantedBy=multi-user.target sing-box.service
