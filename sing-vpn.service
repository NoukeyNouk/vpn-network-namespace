[Unit]
Description=VPN Network Namespace (hy2-vpn)
Documentation=https://sing-box.sagernet.org
After=network-online.target sing-box.service
Wants=network-online.target
Requires=sing-box.service
PartOf=sing-box.service
BindsTo=sing-box.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/noukey/Documents/Mega_vpn
ExecStart=/usr/bin/bash ./setup-netns.sh
ExecStop=/usr/bin/bash ./teardown-netns.sh

[Install]
WantedBy=multi-user.target
