[Unit]
Description=VPN connectivity monitor and rate-limited recovery
After=network-online.target sing-vpn.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bash /usr/local/lib/mega-vpn/vpn-watchdog.sh
Restart=on-failure
RestartSec=10s
UMask=0022

[Install]
WantedBy=multi-user.target
